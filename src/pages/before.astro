---
import Layout from "../layouts/index.astro";

import { Image } from "astro:assets";
import BeforeHeadTitle from "../images/before_head_title.png";
import BeforeHeadCondition from "../images/before_condition.png";
import Vendredi from "../images/vendredi.png";
import Samedi from "../images/samedi.png";

// BAND AESTHESIS
import Aesthesis from "../images/bands/before/aesthesis/image.png";
import AesthesisTitle from "../images/bands/before/aesthesis/title.png";

// BAND ARSEN DOLINE
import ArsenDoline from "../images/bands/before/arsen_doline/image.png";
import ArsenDolineTitle from "../images/bands/before/arsen_doline/title.png";

// BAND ATM SNIPER VICTIM
import AtmSniperVictim from "../images/bands/before/atm_sniper_victim/image.png";
import AtmSniperVictimTitle from "../images/bands/before/atm_sniper_victim/title.png";

// BAND BORGEFUL
import Borgeful from "../images/bands/before/borgeful/image.png";
import BorgefulTitle from "../images/bands/before/borgeful/title.png";

// BAND CARNAGE PIKNIK
import CarnagePiknik from "../images/bands/before/carnage_piknik/image.png";
import CarnagePiknikTitle from "../images/bands/before/carnage_piknik/title.png";

// BAND LEO HOWARD
import LeoHoward from "../images/bands/before/leo_howard/image.png";
import LeoHowardTitle from "../images/bands/before/leo_howard/title.png";

// BAND PRAIRIE SHOOTING
import PrairieShooting from "../images/bands/before/prairie_shooting/image.png";
import PrairieShootingTitle from "../images/bands/before/prairie_shooting/title.png";

// BAND PRIX LIBRE
import PrixLibre from "../images/bands/before/prix_libre/image.png";
import PrixLibreTitle from "../images/bands/before/prix_libre/title.png";

// BAND SODOM ET SAGESSE
import SodomEtSagesse from "../images/bands/before/sodom_et_sagesse/image.png";
import SodomEtSagesseTitle from "../images/bands/before/sodom_et_sagesse/title.png";

// BAND THIBAULT FLORENT
import ThibaultFlorent from "../images/bands/before/thibault_florent/image.png";
import ThibaultFlorentTitle from "../images/bands/before/thibault_florent/title.png";

// BAND TORI
import Tori from "../images/bands/before/tori/image.png";
import ToriTitle from "../images/bands/before/tori/title.png";

// BAND VETUSTE
import Vetuste from "../images/bands/before/vetuste/image.png";
import VetusteTitle from "../images/bands/before/vetuste/title.png";

// TEXT SAMEDI 07
import TextSamedi7 from "../images/before-text-samedi-07.png";
// import TextSamediUnder7 from "../images/before-text-samedi-under.png";


// TEXT SAMEDI 14
import TextSamedi14 from "../images/before-text-samedi-14.png";
// import TextSamediUnder14 from "../images/before-text-samedi-14-under.png";

// TEXT MERCREDI 18
import TextMercredi18 from "../images/before-text-mercredi-18.png";
// import TextMercrediUnder18 from "../images/before-text-mercredi-18-under.png";

// TEXT SAMEDI 21
import TextSamedi21 from "../images/before-text-samedi-21.png";
// import TextSamediUnder21 from "../images/before-text-samedi-21-under.png";

// TEXT SAMEDI 28
import TextSamedi28 from "../images/before-text-samedi-28.png";
// import TextSamediUnder28 from "../images/before-text-samedi-28-under.png";

// BILLETTERIE
import Billetterie from "../images/billetterie.png";

// ARROW
import Arrow from "../images/arrow.png";
---

<Layout title="NO NEW FEST - Before">
	<section class="px-20 flex flex-col" >
		<h2 class="mx-auto" >
			<Image src={BeforeHeadTitle} alt="description de l'event" />
			<Image src={BeforeHeadCondition} alt="event condition" />
		</h2>

		<div>
			<Image src={Aesthesis} alt="Aesthesis" />
			<Image src={AesthesisTitle} alt="Aesthesis" />
		</div>

		<div>
			<Image src={ArsenDoline} alt="Arsen Doline" />
			<Image src={ArsenDolineTitle} alt="Arsen Doline" />
		</div>

		<div>
			<Image src={AtmSniperVictim} alt="ATM Sniper Victim" />
			<Image src={AtmSniperVictimTitle} alt="ATM Sniper Victim" />
		</div>

		<div>
			<Image src={Borgeful} alt="Borgeful" />
			<Image src={BorgefulTitle} alt="Borgeful" />
		</div>

		<Image src={TextSamedi7} alt="Text Samedi 07" />



	</section>

	<section class="px-20 flex flex-col" >
		<header>
			<Image src={Vendredi} alt="Vendredi" />
		</header>
		<div>
			<Image src={CarnagePiknik} alt="Carnage Piknik" />
			<Image src={CarnagePiknikTitle} alt="Carnage Piknik" />
		</div>
		<div>
			<Image src={LeoHoward} alt="Leo Howard" />
			<Image src={LeoHowardTitle} alt="Leo Howard" />
		</div>
		<div>
			<Image src={PrairieShooting} alt="Prairie Shooting" />
			<Image src={PrairieShootingTitle} alt="Prairie Shooting" />
		</div>

		<div>
			<Image src={PrixLibre} alt="Prix Libre" />
			<Image src={PrixLibreTitle} alt="Prix Libre" />
		</div>

		<Image src={TextSamedi14} alt="Text Samedi 14" class="mx-auto" />

	</section>

	<section class="px-20 flex flex-col" >
		<header>
			<Image src={Samedi} alt="Samedi" />
		</header>
		<div>
			<Image src={SodomEtSagesse} alt="Sodom et Sagesse" />
			<Image src={SodomEtSagesseTitle} alt="Sodom et Sagesse" />
		</div>
		<div>
			<Image src={ThibaultFlorent} alt="Thibault Florent" />
			<Image src={ThibaultFlorentTitle} alt="Thibault Florent" />
		</div>

		<div>
			<Image src={Tori} alt="Tori" />
			<Image src={ToriTitle} alt="Tori" />
		</div>

		<div>
			<Image src={Vetuste} alt="Vetuste" />
			<Image src={VetusteTitle} alt="Vetuste" />
		</div>

		<Image src={TextSamedi21} alt="Text Samedi 21" />
	</section>

	<footer slot="footer" class="px-20 flex flex-row items-center justify-center gap-10" > 
		<Image src={Arrow} alt="Arrow" />
		<Image src={Billetterie} alt="Billetterie" />
	</footer>
</Layout>



