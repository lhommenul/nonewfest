---
import Layout from "../layouts/index.astro";

import { Image } from "astro:assets";
import playlist from "../images/label/playlist.png"
import playlistText from "../images/label/description.png"
import playlistTextDesktop from "../images/label/description_desktop.png"
import email from "../images/label/email.png"
import instagram from "../images/label/instagram.png"

import Header from "../components/Header.astro"
---

<Layout title="NO NEW FEST">
	<Header />
	<!-- <Image src={banner} alt="Banner"  /> -->
	<video src="/aftermovie.mp4" autoplay muted playsinline loop preload="metadata" class="mx-auto mt-2 sm:mb-[63px] sm:mt-8 max-h-[764px]" ></video>

	<div class="mt-6 px-6 sm:mt[33px] max-w-[1021px] mx-auto" >
		<a href="https://youtube.com/playlist?list=PLi_86_tcBWl9KvYnqtGo77qkx2GGsbJqR&si=fcnXjW7wLs8S8X1o" target="_blank" >
			<Image src={playlist} alt="Playlist" class="mx-auto w-[163px] sm:w-[331px] cursor-pointer hover:scale-102 transition-all" />
		</a>
		<Image src={playlistText} alt="" class="mx-auto w-full sm:hidden" />
		<Image src={playlistTextDesktop} alt="" class="mx-auto w-full hidden sm:block mt-[59px]" />
	</div>

	<footer class="px-4 mx-auto flex flex-row sm:flex-col-reverse items-center justify-between mb-8 sm:mt-[33px] max-w-[1440px]" >
		<a href="mailto:reversetapes@gmail.com" target="_blank" class="w-[173px] sm:w-[357px] lg:ml-auto lg:mr-0 mr-auto cursor-pointer hover:scale-102 transition-all" >
			<Image src={email} alt="Email" />
		</a>
		<a href="https://www.instagram.com/nonew_fest/" target="_blank" class="w-[32px] sm:w-[53px] sm:ml-auto sm:relative sm:right-4 sm:mt-[130px] cursor-pointer hover:scale-102 transition-all" >
			<Image src={instagram} alt="Instagram" />
		</a>
	</footer>

	<script>
		document.addEventListener('DOMContentLoaded', function() {
			const video = document.querySelector('video');

			if (video) {

				video.muted = true;
				// Rend la vidéo cliquable visuellement
				video.style.cursor = 'pointer';

				// Ajoute l'événement click pour toggle mute/unmute
				video.addEventListener('click', function() {
					video.muted = !video.muted;
				});
			}
		});
	</script>
</Layout>
