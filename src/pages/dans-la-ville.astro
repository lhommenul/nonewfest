---
import Layout from "../layouts/index.astro";

import { Image } from "astro:assets";
import BeforeHeadTitleDesktop from "../images/la-ville/header/title.png";
import BeforeHeadTitle from "../images/la-ville/header/title_mobile.png";
import BeforeHeadCondition from "../images/la-ville/header/subtitle.png";


// ===== SAMEDI 07
import TextSamedi7 from "../images/la-ville/samedi-07/title.png";
import TextSamedi7Subtitle from "../images/la-ville/samedi-07/subtitle.png";

// BAND ATM SNIPER VICTIM
import RachelTitle from "../images/la-ville/samedi-07/rachel-title.png";
import RachelImage from "../images/la-ville/samedi-07/rachel-image.png";

import PrairieImage from "../images/la-ville/samedi-07/prairie-image.png";
import PrairieTitle from "../images/la-ville/samedi-07/prairie-title.png";

// ===== SAMEDI 14
import TextSamedi14 from "../images/la-ville/samedi-14/title.png";
import TextSamedi14Subtitle from "../images/la-ville/samedi-14/subtitle.png";


// BAND PRIX LIBRE
import PrixLibre from "../images/la-ville/samedi-14/prix-image.png";
import PrixLibreTitle from "../images/la-ville/samedi-14/prix-title.png";

// BAND AESTHESIS
import Aesthesis from "../images/la-ville/samedi-14/aest-image.png";
import AesthesisTitle from "../images/la-ville/samedi-14/aest-title.png";

// ===== MERCREDI 18
import TextMercredi18 from "../images/la-ville/mercredi-18/title.png";
import TextMercredi18Subtitle from "../images/la-ville/mercredi-18/subtitle.png";

// BAND THIBAULT FLORENT
import ThibaultFlorent from "../images/la-ville/mercredi-18/thibault-image.png";
import ThibaultFlorentTitle from "../images/la-ville/mercredi-18/thibault-title.png";


// BAND ARSEN DOLINE
import ArsenDoline from "../images/la-ville/mercredi-18/arsen-image.png";
import ArsenDolineTitle from "../images/la-ville/mercredi-18/arsen-title.png";

// ===== SAMEDI 21
import TextSamedi21 from "../images/la-ville/samedi-21/title.png";
import TextSamedi21Subtitle from "../images/la-ville/passe-store/title.png";

// BAND BORGEFUL
import Borgeful from "../images/la-ville/samedi-21/borgue-image.png";
import BorgefulTitle from "../images/la-ville/samedi-21/borgue-title.png";

// BAND BORGEFUL
import Doctrove from "../images/la-ville/samedi-21/doctrove-image.png";
import DoctroveTitle from "../images/la-ville/samedi-21/doctrove-title.png";

// PasseStore
import AtMaisonMaison from "../images/la-ville/samedi-21/subtitle.png";

// BAND LEO HOWARD
import LeoHoward from "../images/la-ville/passe-store/leo-image.png";
import LeoHowardTitle from "../images/la-ville/passe-store/leo-title.png";

// BAND TORI
import Tori from "../images/la-ville/passe-store/tori-image.png";
import ToriTitle from "../images/la-ville/passe-store/tori-title.png";

// ===== VENDREDI 27 MARS
import Vendredi27Title from "../images/la-ville/vendredi-27/title.png";
import Vendredi27Subtitle from "../images/la-ville/vendredi-27/subtitle.png";

import BaptisteTitle from "../images/la-ville/vendredi-27/baptiste-title.png";
import BaptisteImage from "../images/la-ville/vendredi-27/baptiste-image.png";

import ATMTitle from "../images/la-ville/mercredi-18/atm-title.png";
import ATMImage from "../images/la-ville/mercredi-18/atm-image.png";

// BAND CARNAGE PIKNIK
import CarnagePiknik from "../images/la-ville/samedi-28/carnage-image.png";
import CarnagePiknikTitle from "../images/la-ville/samedi-28/carnage-title.png";


// BAND SODOM ET SAGESSE
import SodomEtSagesse from "../images/la-ville/samedi-28/sodom-image.png";
import SodomEtSagesseTitle from "../images/la-ville/samedi-28/sodom-title.png";

// BAND VETUSTE
import Vetuste from "../images/la-ville/samedi-28/vetuste-image.png";
import VetusteTitle from "../images/la-ville/samedi-28/vetuste-title.png";

// import TextSamediUnder7 from "../images/before-text-samedi-under.png";

// import TextSamediUnder21 from "../images/before-text-samedi-21-under.png";

// BILLETTERIE
import Billetterie from "../images/billetterie.png";

// ARROW
import Arrow from "../images/arrow.png";

import Header from "../components/Header.astro"
---

<Layout title="NO NEW FEST - Before">
	<Header />
	<section class=" flex flex-col max-w-[1440px] lg:mx-auto" >
		<h2 class="mx-auto px-7 mt-[54px]" >
			<Image src={BeforeHeadTitle} alt="description de l'event" class="visible md:hidden w-full" />
			<Image src={BeforeHeadTitleDesktop} alt="description de l'event" class="hidden md:block" />
			<Image src={BeforeHeadCondition} alt="event condition" class="ml-auto lg:relative lg:bottom-12 lg:right-6" />
		</h2>

		<!-- SAMEDI 07 -->

		<div class="flex justify-center items-center flex-col h-[80px] px-7 mt-[100px] lg:mt-[190px]" >

			<Image src={TextSamedi7} alt="Text Samedi 07" class="w-[290px] lg:w-[689px] relative right-6" />
			<Image src={TextSamedi7Subtitle} alt="Text Samedi 07" class="w-[96px] lg:w-[162px] relative bottom-5 left-30 lg:left-70 lg:bottom-8" />

		</div>

		<div class="mx-auto flex flex-col justify-center items-center px-7 lg:mt-[222px]" >
			<div class="flex flex-col justify-center items-center" >
				<Image src={RachelTitle} alt="" class="w-[292px] lg:w-[759px] relative top-2 left-3 lg:left-8" />
				<Image src={RachelImage} alt="" class="w-[245px] lg:w-[632px]" />
			</div>
			<div class="flex flex-col justify-center items-center relative bottom-1" >
				<Image src={PrairieImage} alt="Prairie Shooting" class="w-[248px] lg:w-[632px]" />
				<Image src={PrairieTitle} alt="Prairie Shooting" class="w-[321px] lg:w-[832px] relative right-3 lg:right-12" />
			</div>
		</div>

		<!-- SAMEDI 14 -->

		<div class="mx-auto px-7 mt-[112px] h-[50px] lg:mt-[323px] lg:relative lg:left-70" >
			<Image src={TextSamedi14} alt="Text Samedi 14" class="mx-auto lg:w-[701px] w-[284px]" />
			<Image src={TextSamedi14Subtitle} alt="Text Samedi 14" class="mx-auto h-auto ml-auto w-[158px] lg:w-[378px] relative left-16 lg:ml-auto lg:mr-26" />
		</div>

		<div class="mx-auto flex flex-col mt-6 lg:mt-60 justify-center items-center px-7 lg:flex-row-reverse relative bottom-4" >

			<div class="flex flex-col-reverse justify-center items-center cursor-pointer mb-auto z-20 lg:right-4 lg:relative lg:bottom-4 hover:scale-102 transition-all"  >
				<Image onclick="window.open('https://www.youtube.com/watch?v=qtXBC2HGF-A', '_blank')" src={PrixLibre} alt="Prix Libre" class="w-[249px] lg:w-[449px]" />
				<Image onclick="window.open('https://www.youtube.com/watch?v=qtXBC2HGF-A', '_blank')" src={PrixLibreTitle} alt="Prix Libre" class="w-[96px] lg:w-[209px] h-auto relative right-15 top-4 lg:top-12 lg:-right-48 " />
			</div>

			<div class="flex flex-col justify-center items-center mr-auto relative bottom-8 lg:left-4"  >
				<Image src={Aesthesis} alt="Aesthesis" class="w-[237px] lg:w-[513px] relative right-2" />
				<Image src={AesthesisTitle} alt="Aesthesis" class="mr-auto lg:w-[225px] relative bottom-5 left-1 h-auto w-[104px]" />
			</div>

		</div>

		<!-- MERCREDI 18 -->

		<div class="flex flex-col justify-center items-center px-7 h-[80px] mt-[90px] lg:mt-[536px] lg:px-20" >
			<Image src={TextMercredi18} alt="" class="h-auto w-[347px] lg:w-[726px] lg:mr-auto" />
			<Image src={TextMercredi18Subtitle} alt="" class="w-[250px] h-auto relative bottom-13 left-23 lg:w-[456px] lg:bottom-25 lg:mr-auto lg:ml-0 lg:left-90" />
		</div>

		<div class="flex flex-col justify-center items-center lg:px-20 lg:mt-[74px]" >

			<div class="flex justify-center items-center flex-col-reverse cursor-pointer lg:mr-auto lg:ml-20 relative left-17 hover:scale-102 transition-all" >
				<Image onclick="window.open('https://youtu.be/01j4cp8jXSQ?si=QNuSVMAEtPHmQoYX', '_blank')" src={ArsenDoline} alt="Arsen Doline" class="w-[257px] ml-auto lg:w-[637px]" />
				<Image onclick="window.open('https://youtu.be/01j4cp8jXSQ?si=QNuSVMAEtPHmQoYX', '_blank')" src={ArsenDolineTitle} alt="Arsen Doline" class=" relative top-4 right-14 -rotate-6 h-10 w-auto lg:-right-80 lg:w-[324px] lg:h-auto lg:top-12 lg:rotate-2" />
			</div>

			<div class="flex justify-center items-center cursor-pointer flex-col w-full relative bottom-6 lg:bottom-30 hover:scale-102 transition-all" >
				<Image onclick="window.open('https://youtu.be/EuU9P6qs5YU?si=dWeu2-w8AScfLAQi', '_blank')" src={ThibaultFlorentTitle} alt="Thibault Florent" class="h-auto w-[164px] lg:w-[367px] relative right-26 lg:-right-120 lg:top-2 lg:z-10" />
				<Image onclick="window.open('https://youtu.be/EuU9P6qs5YU?si=dWeu2-w8AScfLAQi', '_blank')" src={ThibaultFlorent} alt="Thibault Florent" class="w-full max-w-[707px] lg:relative lg:left-40" />
			</div>

			<div class="flex justify-center items-center flex-col relative bottom-4 lg:right-55 lg:bottom-28" >
				<Image src={ATMImage} alt="ATMImage" class="h-auto w-[300px] lg:w-[631px] relative left-9 bottom-3" />
				<Image src={ATMTitle} alt="ATMTitle" class="h-auto w-[217px] lg:w-[508px] relative bottom-4 right-14 lg:-right-80" />
			</div>

		</div>

		<!-- SAMEDI 21 -->

		<div class="flex flex-col justify-center items-center px-7 lg:mr-12 mt-[150px] lg:relative lg:left-90 lg:rotate-4 lg:mt-0" >
			<Image src={TextSamedi21} alt="" class="-rotate-4 lg:mt-[203px] lg:w-[646px] w-[342px] h-auto " />
			<Image src={TextSamedi21Subtitle} alt="" class="h-auto w-[212px] lg:w-[440px] lg:-right-40 lg:-top-4 relative bottom-4 right-19 -rotate-2 lg:bottom-12" />
		</div>

		<div class="flex flex-col lg:flex-row lg:mx-auto justify-center items-center px-7" >
			<a class="flex flex-col-reverse hover:scale-102 transition-all cursor-pointer justify-center items-center ml-auto lg:mb-60" href="https://tori-tori.bandcamp.com/album/tori-a" target="_blank"  >
				<Image onclick="window.open('https://tori-tori.bandcamp.com/album/tori-a', '_blank')"	 src={Tori} alt="Tori" class="w-[213px] lg:w-[509px]" />
				<Image onclick="window.open('https://tori-tori.bandcamp.com/album/tori-a', '_blank')"	 src={ToriTitle} alt="Tori" class="w-[60px] lg:w-[121px] relative right-25 top-3 lg:top-138 lg:right-54" />
			</a>
			<a class="hover:scale-102 transition-all relative right-8 cursor-pointer lg:right-0 flex flex-col-reverse justify-center items-center" href="https://youtu.be/Ef_W4Ltc820?si=dEkoJW6LYpg782-m" target="_blank"  >
				<Image onclick="window.open('https://youtu.be/Ef_W4Ltc820?si=dEkoJW6LYpg782-m', '_blank')" src={LeoHowardTitle} alt="Leo Howard" class="w-[160px] lg:w-[295px] lg:left-32 relative left-22 bottom-5" />
				<Image onclick="window.open('https://youtu.be/Ef_W4Ltc820?si=dEkoJW6LYpg782-m', '_blank')" src={LeoHoward} alt="Leo Howard" class="w-[201px] lg:w-[505px]" />
			</a>
		</div>

		<!-- Maison maison -->

		<div class="flex flex-col justify-center items-center px-7 mt-[104px] lg:mt-[224px] mb-[20px]">
			<Image src={AtMaisonMaison} alt="passe store" class="mx-auto w-[278px] lg:w-[452px] lg:rotate-2 lg:-right-105 relative right-6" />
		</div> 

		<div class="flex flex-col justify-center items-center lg:flex-col lg:mx-auto lg:px-28 lg-mt-[34px]" >
			<div class="flex flex-col-reverse justify-center items-center ml-auto lg:relative lg:left-42 cursor-pointer" >
				<Image onclick="window.open('https://youtu.be/1C9EhTZlI8w?si=RuhHF3c0h9BbGzfa', '_blank')" src={Borgeful} alt="Borgeful" class="w-[303px] lg:w-[726px]" />
				<Image onclick="window.open('https://youtu.be/1C9EhTZlI8w?si=RuhHF3c0h9BbGzfa', '_blank')" src={BorgefulTitle} alt="Borgeful" class="lg:w-[231px] mr-auto relative right-6 top-2 w-[99px] h-auto lg:right-32 lg:top-5" />
			</div>
			<div class="flex flex-col justify-center items-center relative bottom-10 mr-auto lg:bottom-0" >
				<Image src={Doctrove} alt="Borgeful" class="w-[262px] mr-auto lg:w-[655px]" />
				<Image src={DoctroveTitle} alt="Borgeful" class="h-auto w-[120px] lg:w-[244px] relative bottom-1 right-17 lg:-right-78 lg:bottom-10" />
			</div>
		</div>

	</section>

	<section class="flex flex-col max-w-[1440px] lg:mx-auto lg:mb-20" >
		<header class="px-7 flex flex-col justify-center items-center w-full mt-[111px] lg:mt-[303px] lg:relative lg:right-80" >
			<Image src={Vendredi27Title} alt="Vendredi27Title" class="w-[370px] lg:w-[673px]" />
			<Image src={Vendredi27Subtitle} alt="Vendredi27Subtitle" class="w-[178px] lg:w-[241px] relative left-18 lg:left-48 lg:bottom-4" />
		</header>
		<div class="lg:grid lg:grid-cols-2 lg:grid-rows-2 flex flex-col justify-center items-center lg:px-7 lg:h-[1000px] mt-[33px] mb-8" >
			<a class="flex flex-col justify-center items-center lg:relative lg:left-75 lg:top-50 lg:row-span-1 lg:col-span-2 hover:scale-102 transition-all cursor-pointer" >
				<Image onclick="window.open('https://youtu.be/_hu5m8MOVcw?si=2J8QrVIthwd17t9P', '_blank')" src={CarnagePiknik} alt="Carnage Piknik" class="h-auto w-[210px] lg:w-[452px]" />
				<Image onclick="window.open('https://youtu.be/_hu5m8MOVcw?si=2J8QrVIthwd17t9P', '_blank')" src={CarnagePiknikTitle} alt="Carnage Piknik" class="w-[174px] lg:w-[335px] lg:bottom-170 relative -rotate-4 bottom-5 left-18 lg:left-38" />
			</a>
	
			<a class="flex flex-col justify-center items-center relative left-10 lg:left-20 lg:top-88 lg:row-span-2 cursor-pointer lg:col-span-1 hover:scale-102 transition-all" >
				<Image onclick="window.open('https://youtu.be/gnDwQQtct_Q?si=WZKB4YGyKv7YGzhQ', '_blank')" src={VetusteTitle} alt="Vetuste" class="w-[113px] lg:w-[167px] relative top-4 right-27 lg:top-130 lg:-right-40" />
				<Image onclick="window.open('https://youtu.be/gnDwQQtct_Q?si=WZKB4YGyKv7YGzhQ', '_blank')" src={Vetuste} alt="Vetuste" class="w-[301px] lg:w-[613px] ml-auto" />
			</a>
			<a class="flex flex-col justify-center items-center lg:row-span-1 lg:col-span-1 lg:relative lg:right-110 cursor-pointer hover:scale-102 transition-all" >
				<Image onclick="window.open('https://youtu.be/K1z-ctOpXcs?si=kFp6KIp-_DpOYIq0', '_blank')" src={SodomEtSagesse} alt="Sodom et Sagesse" class="w-[264px] lg:w-[528px] h-auto relative bottom-1 right-6" />
				<Image onclick="window.open('https://youtu.be/K1z-ctOpXcs?si=kFp6KIp-_DpOYIq0', '_blank')" src={SodomEtSagesseTitle} alt="Sodom et Sagesse" class="w-[159px] lg:w-[245px] relative right-26 rotate-6 lg:rotate-0 lg:bottom-98 lg:right-60 bottom-6" />
			</a>
			<a class="flex flex-col justify-center items-center lg:row-span-2 lg:col-span-2 lg:relative lg:left-74 lg:top-20" >
				<Image src={BaptisteImage} alt="Baptiste" class="w-[219px] lg:w-[444px] h-auto " />
				<Image src={BaptisteTitle} alt="Baptiste" class="w-[141px] lg:w-[305px] -rotate-3 relative bottom-2 -right-26 lg:bottom-6 lg:rotate-1 lg:-right-40" />
			</a>
		</div>


	</section>


	<footer slot="footer" class="px-20 flex flex-row items-center justify-center gap-10" > 
		<Image src={Arrow} alt="Arrow" />
		<a href="https://www.helloasso.com/associations/reverse-tapes/evenements/no-new-fest-2026" class="hover:scale-102 transition-all cursor-pointer" target="_blank">
			<Image src={Billetterie} alt="Billetterie" />
		</a>
	</footer>
</Layout>



