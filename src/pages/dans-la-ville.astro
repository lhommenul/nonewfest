---
import Layout from "../layouts/index.astro";

import { Image } from "astro:assets";
import BeforeHeadTitleDesktop from "../images/la-ville/header/title.png";
import BeforeHeadTitle from "../images/la-ville/header/title_mobile.png";
import BeforeHeadCondition from "../images/la-ville/header/subtitle.png";
import Vendredi from "../images/vendredi.png";
import Samedi from "../images/samedi.png";


// ===== SAMEDI 07
import TextSamedi7 from "../images/la-ville/samedi-07/title.png";
import TextSamedi7Subtitle from "../images/la-ville/samedi-07/subtitle.png";

// BAND ATM SNIPER VICTIM
import AtmSniperVictim from "../images/la-ville/samedi-07/atm-image.png";
import AtmSniperVictimTitle from "../images/la-ville/samedi-07/atm-title.png";

// BAND PRAIRIE SHOOTING
import PrairieShooting from "../images/la-ville/samedi-07/prairie-image.png";
import PrairieShootingTitle from "../images/la-ville/samedi-07/prairie-title.png";


// ===== SAMEDI 14
import TextSamedi14 from "../images/la-ville/samedi-14/title.png";
import TextSamedi14Subtitle from "../images/la-ville/samedi-14/subtitle.png";


// BAND PRIX LIBRE
import PrixLibre from "../images/la-ville/samedi-14/prix-image.png";
import PrixLibreTitle from "../images/la-ville/samedi-14/prix-title.png";

// BAND AESTHESIS
import Aesthesis from "../images/la-ville/samedi-14/aest-image.png";
import AesthesisTitle from "../images/la-ville/samedi-14/aest-title.png";

// ===== MERCREDI 18
import TextMercredi18 from "../images/la-ville/mercredi-18/title.png";
import TextMercredi18Subtitle from "../images/la-ville/mercredi-18/subtitle.png";

// BAND THIBAULT FLORENT
import ThibaultFlorent from "../images/la-ville/mercredi-18/thibault-image.png";
import ThibaultFlorentTitle from "../images/la-ville/mercredi-18/thibault-title.png";


// BAND ARSEN DOLINE
import ArsenDoline from "../images/la-ville/mercredi-18/arsen-image.png";
import ArsenDolineTitle from "../images/la-ville/mercredi-18/arsen-title.png";

// ===== SAMEDI 21
import TextSamedi21 from "../images/la-ville/samedi-21/title.png";
import TextSamedi21Subtitle from "../images/la-ville/samedi-21/subtitle.png";

// BAND BORGEFUL
import Borgeful from "../images/la-ville/samedi-21/borgue-image.png";
import BorgefulTitle from "../images/la-ville/samedi-21/borgue-title.png";

// BAND BORGEFUL
import Doctrove from "../images/la-ville/samedi-21/doctrove-image.png";
import DoctroveTitle from "../images/la-ville/samedi-21/doctrove-title.png";

// PasseStore
import PasseStore from "../images/la-ville/passe-store/title.png";

// BAND LEO HOWARD
import LeoHoward from "../images/la-ville/passe-store/leo-image.png";
import LeoHowardTitle from "../images/la-ville/passe-store/leo-title.png";

// BAND TORI
import Tori from "../images/la-ville/passe-store/tori-image.png";
import ToriTitle from "../images/la-ville/passe-store/tori-title.png";

// ===== SAMEDI 26
import Samedi28Title from "../images/la-ville/samedi-28/title.png";
import Samedi28Subtitle from "../images/la-ville/samedi-28/subtitle.png";


// BAND CARNAGE PIKNIK
import CarnagePiknik from "../images/la-ville/samedi-28/carnage-image.png";
import CarnagePiknikTitle from "../images/la-ville/samedi-28/carnage-title.png";


// BAND SODOM ET SAGESSE
import SodomEtSagesse from "../images/la-ville/samedi-28/sodom-image.png";
import SodomEtSagesseTitle from "../images/la-ville/samedi-28/sodom-title.png";

// BAND VETUSTE
import Vetuste from "../images/la-ville/samedi-28/vetuste-image.png";
import VetusteTitle from "../images/la-ville/samedi-28/vetuste-title.png";

// import TextSamediUnder7 from "../images/before-text-samedi-under.png";

// import TextSamediUnder21 from "../images/before-text-samedi-21-under.png";

// BILLETTERIE
import Billetterie from "../images/billetterie.png";

// ARROW
import Arrow from "../images/arrow.png";

import Header from "../components/Header.astro"
---

<Layout title="NO NEW FEST - Before">
	<Header />
	<section class=" flex flex-col max-w-[1440px] lg:mx-auto" >
		<h2 class="mx-auto px-7 mt-[54px]" >
			<Image src={BeforeHeadTitle} alt="description de l'event" class="visible md:hidden w-full" />
			<Image src={BeforeHeadTitleDesktop} alt="description de l'event" class="hidden md:block" />
			<Image src={BeforeHeadCondition} alt="event condition" class="ml-auto" />
		</h2>

		<!-- SAMEDI 07 -->

		<div class="flex justify-center items-center flex-col h-fit px-7" >

			<Image src={TextSamedi7} alt="Text Samedi 07" class="mr-auto lg:mx-auto lg:max-w-[700px]" />
			<Image src={TextSamedi7Subtitle} alt="Text Samedi 07" class="h-18 lg:h-24 w-fit ml-auto relative bottom-12 lg:mx-auto lg:left-60 lg:bottom-22 lg:max-w-[162px]" />

		</div>

		<div class="mx-auto flex flex-col justify-center items-center px-7" >
			<div class="flex flex-col justify-center items-center mx-8 z-20 w-full" >
				<Image onclick="window.open('https://youtu.be/qr_QyxBYbnM?si=1Oc7nVQZhLrfm9yi', '_blank')" src={AtmSniperVictimTitle} alt="ATM Sniper Victim" class="relative left-16 top-4 h-6 w-auto lg:h-12 lg:left-32" />
				<Image onclick="window.open('https://youtu.be/qr_QyxBYbnM?si=1Oc7nVQZhLrfm9yi', '_blank')" src={AtmSniperVictim} alt="ATM Sniper Victim" class="w-full max-w-[631px]" />
			</div>
			<div class="flex flex-col justify-center items-center mx-8 w-full relative bottom-4" >
				<Image src={PrairieShooting} alt="Prairie Shooting" class="w-full h-auto max-w-[631px]" />
				<Image src={PrairieShootingTitle} alt="Prairie Shooting" class="relative right-6 bottom-2 h-6 lg:h-12 w-auto" />
			</div>
		</div>

		<!-- SAMEDI 14 -->

		<div class="mx-auto px-7 lg:mt-[458px] mt-[112px] lg:ml-auto lg:mr-0" >
			<Image src={TextSamedi14} alt="Text Samedi 14" class="mx-auto lg:max-w-[701px]" />
			<Image src={TextSamedi14Subtitle} alt="Text Samedi 14" class="mx-auto h-26 ml-auto w-fit relative left-14 bottom-4 lg:ml-auto lg:mr-26" />
		</div>

		<div class="mx-auto flex flex-col mt-6 justify-center items-center px-7 lg:flex-row-reverse" >

			<div class="flex flex-col-reverse justify-center items-center mb-auto z-20 lg:right-4 lg:relative lg:bottom-4"  >
				<Image onclick="window.open('https://www.youtube.com/watch?v=qtXBC2HGF-A', '_blank')" src={PrixLibre} alt="Prix Libre" />
				<Image onclick="window.open('https://www.youtube.com/watch?v=qtXBC2HGF-A', '_blank')" src={PrixLibreTitle} alt="Prix Libre" class="w-auto mr-auto relative left-4 top-8 h-12 lg:left-100 lg:top-14 lg:h-[49px]" />
			</div>

			<div class="flex flex-col justify-center items-center mr-auto relative bottom-8 lg:left-4"  >
				<Image src={Aesthesis} alt="Aesthesis" />
				<Image src={AesthesisTitle} alt="Aesthesis" class="mr-auto relative bottom-5 left-4 h-7 w-auto lg:h-[49px]" />
			</div>

		</div>

		<!-- MERCREDI 18 -->

		<div class="flex flex-col justify-center items-center px-7 lg:mt-[536px] lg:px-20" >
			<Image src={TextMercredi18} alt="" class="lg:h-[102px] lg:w-auto lg:mr-auto" />
			<Image src={TextMercredi18Subtitle} alt="" class="ml-auto h-24 w-auto relative bottom-14 left-14 lg:w-auto lg:mr-auto lg:ml-0 lg:left-70 lg:h-[116px]" />
		</div>

		<div class="flex flex-col justify-center items-center lg:px-20" >

			<div class="flex justify-center items-center flex-col-reverse lg:mr-auto lg:ml-20" >
				<Image onclick="window.open('https://youtu.be/01j4cp8jXSQ?si=QNuSVMAEtPHmQoYX', '_blank')" src={ArsenDoline} alt="Arsen Doline" class="w-2/3 ml-auto max-w-[637px] lg:w-full	 lg:mr-auto lg:ml-0" />
				<Image onclick="window.open('https://youtu.be/01j4cp8jXSQ?si=QNuSVMAEtPHmQoYX', '_blank')" src={ArsenDolineTitle} alt="Arsen Doline" class=" relative top-4 right-14 -rotate-6 h-10 w-auto lg:-right-80 lg:h-[45px] lg:rotate-2" />
			</div>

			<div class="flex justify-center items-center flex-col w-full relative bottom-2" >
				<Image onclick="window.open('https://youtu.be/EuU9P6qs5YU?si=dWeu2-w8AScfLAQi', '_blank')" src={ThibaultFlorent} alt="Thibault Florent" class="w-full max-w-[707px] lg:relative lg:left-40" />
				<Image onclick="window.open('https://youtu.be/EuU9P6qs5YU?si=dWeu2-w8AScfLAQi', '_blank')" src={ThibaultFlorentTitle} alt="Thibault Florent" class="relative bottom-2 h-5 mr-auto lg:h-[37px] w-auto lg:left-70" />
			</div>

		</div>

		<!-- SAMEDI 21 -->

		<div class="flex flex-col justify-center items-center px-7 lg:mr-12" >
			<Image src={TextSamedi21} alt="" class="-rotate-4 lg:mt-[403px] lg:ml-auto lg:mr-0" />
			<Image src={TextSamedi21Subtitle} alt="" class="ml-auto h-28 w-auto relative bottom-12 left-4 -rotate-2 lg:bottom-12" />
		</div>

		<div class="flex flex-col justify-center items-center px-7" >
			<div class="flex flex-col-reverse justify-center items-center" >
				<Image onclick="window.open('https://youtu.be/1C9EhTZlI8w?si=RuhHF3c0h9BbGzfa', '_blank')" src={Borgeful} alt="Borgeful" class="w-4/5 ml-auto" />
				<Image onclick="window.open('https://youtu.be/1C9EhTZlI8w?si=RuhHF3c0h9BbGzfa', '_blank')" src={BorgefulTitle} alt="Borgeful" class="mr-auto relative left-12 top-8 h-10 -rotate-8 w-auto" />
			</div>
			<div class="flex flex-col justify-center items-center relative bottom-10 ml-4" >
				<Image src={Doctrove} alt="Borgeful" class="w-4/5 mr-auto " />
				<Image src={DoctroveTitle} alt="Borgeful" class="mr-auto h-10 w-auto relative bottom-1 lg:ml-auto lg:mr-0 lg:right-8 lg:bottom-6" />
			</div>
		</div>

		<!-- Passe passe store -->

		<div class="px-7">
			<Image src={PasseStore} alt="passe store" class="mx-auto lg:mt-[400px] lg:mr-auto lg:ml-0" />
		</div> 

		<div class="flex flex-col justify-center items-center px-7 lg:flex-row lg:mx-auto lg:px-28" >
			<a class="flex flex-col-reverse justify-center items-center ml-auto lg:mb-60" href="https://tori-tori.bandcamp.com/album/tori-a" target="_blank" >
				<Image onclick="window.open('https://tori-tori.bandcamp.com/album/tori-a', '_blank')"	 src={Tori} alt="Tori" class="w-6/8 ml-auto max-w-[509px] lg:w-full" />
				<Image onclick="window.open('https://tori-tori.bandcamp.com/album/tori-a', '_blank')"	 src={ToriTitle} alt="Tori" class="mr-auto relative left-12 h-10 w-auto top-4 lg:top-120 lg:h-[52px] lg:-left-10" />
			</a>
			<a class="flex flex-col-reverse justify-center items-center" href="https://youtu.be/Ef_W4Ltc820?si=dEkoJW6LYpg782-m" target="_blank" >
				<Image onclick="window.open('https://youtu.be/Ef_W4Ltc820?si=dEkoJW6LYpg782-m', '_blank')" src={LeoHowardTitle} alt="Leo Howard" class="relative bottom-6 left-10 h-12 w-auto lg:left-60 lg:h-12" />
				<Image onclick="window.open('https://youtu.be/Ef_W4Ltc820?si=dEkoJW6LYpg782-m', '_blank')" src={LeoHoward} alt="Leo Howard" class="w-6/8 mr-auto ml-4 max-w-[505px] lg:w-full" />
			</a>
		</div>

	</section>

	<section class="flex flex-col max-w-[1440px] lg:mx-auto" >
		<header class="px-7 flex flex-col justify-center items-center w-full mt-[126px] lg:ml-40 lg:mt-[320px]" >
			<Image src={Samedi28Title} alt="Samedi26Title" class="lg:max-w-[615px] w-[358px] h-auto lg:mr-auto lg:w-full" />
			<Image src={Samedi28Subtitle} alt="Samedi28Subtitle" class="w-[178px] relative bottom-8 h-auto left-26 lg:w-auto lg:-left-30 lg:h-[97px]" />
		</header>
		<div class="flex flex-col justify-center items-center lg:px-7 lg:h-[600px]" >
			<a class="flex flex-col justify-center items-center lg:relative lg:left-80 lg:top-100" >
				<Image onclick="window.open('https://youtu.be/_hu5m8MOVcw?si=2J8QrVIthwd17t9P', '_blank')" src={CarnagePiknik} alt="Carnage Piknik" class="lg:h-[642px] lg:w-full w-[210px] max-w-[452px]" />
				<Image onclick="window.open('https://youtu.be/_hu5m8MOVcw?si=2J8QrVIthwd17t9P', '_blank')" src={CarnagePiknikTitle} alt="Carnage Piknik" class="ml-auto relative h-[38px] w-auto left-8 bottom-4 lg:h-18 lg:w-auto lg:bottom-160 lg:rotate-4" />
			</a>
	
			<a class="flex flex-col justify-center items-center ml-auto lg:mr-auto lg:relative lg:right-40 lg:top-50" >
				<Image onclick="window.open('https://youtu.be/gnDwQQtct_Q?si=WZKB4YGyKv7YGzhQ', '_blank')" src={VetusteTitle} alt="Vetuste" class="ml-auto relative right-60 h-[38px] w-auto top-4 lg:h-[57px] lg:top-125 lg:right-10" />
				<Image onclick="window.open('https://youtu.be/gnDwQQtct_Q?si=WZKB4YGyKv7YGzhQ', '_blank')" src={Vetuste} alt="Vetuste" class="lg:w-full max-w-[613px] w-[310px] ml-auto" />
			</a>
			<a class="flex flex-col justify-center items-center mr-auto ml-12 relative bottom-5 lg:bottom-155 lg:right-20 lg:mx-auto" >
				<Image onclick="window.open('https://youtu.be/K1z-ctOpXcs?si=kFp6KIp-_DpOYIq0', '_blank')" src={SodomEtSagesse} alt="Sodom et Sagesse" class=" lg:w-full w-4/5 lg:max-w-[528px]" />
				<Image onclick="window.open('https://youtu.be/K1z-ctOpXcs?si=kFp6KIp-_DpOYIq0', '_blank')" src={SodomEtSagesseTitle} alt="Sodom et Sagesse" class="mr-auto relative bottom-3 right-6 lg:bottom-95 lg:-rotate-0 lg:h-[36px] h-[24px] w-auto rotate-5" />
			</a>
		</div>


	</section>


	<footer slot="footer" class="px-20 flex flex-row items-center justify-center gap-10" > 
		<Image src={Arrow} alt="Arrow" />
		<a href="https://www.helloasso.com/associations/reverse-tapes/evenements/no-new-fest-2026" target="_blank">
			<Image src={Billetterie} alt="Billetterie" />
		</a>
	</footer>
</Layout>



