---
import Layout from "../layouts/index.astro";

import { Image } from "astro:assets";

import Header from "../components/Header.astro"

// JEUDI 19 MARS
import Jeudi19Mars from "../images/le-bateau-ivre/jeudi-19/title.png"

import FutuTitle from "../images/le-bateau-ivre/jeudi-19/futu-title.png"
import FutuImage from "../images/le-bateau-ivre/jeudi-19/futu-image.png"

import PapierTitle from "../images/le-bateau-ivre/jeudi-19/papier-title.png"
import PapierImage from "../images/le-bateau-ivre/jeudi-19/papier-image.png"

import OneHundredTitle from "../images/le-bateau-ivre/jeudi-19/178-title.png"
import OneHundredImage from "../images/le-bateau-ivre/jeudi-19/178-image.png"

import DwyneTitle from "../images/le-bateau-ivre/jeudi-19/dwyne-title.png"
import DwyneImage from "../images/le-bateau-ivre/jeudi-19/dwyne-image.png"

import GunsTitle from "../images/le-bateau-ivre/jeudi-19/guns-title.png"
import GunsImage from "../images/le-bateau-ivre/jeudi-19/guns-image.png"

// BENDREDI 20 MARS
import Vendredi20Mars from "../images/le-bateau-ivre/vendredi-20/title.png"

import WhatTitle from "../images/le-bateau-ivre/vendredi-20/what-title.png"
import WhatImage from "../images/le-bateau-ivre/vendredi-20/what-image.png"

import MotoTitle from "../images/le-bateau-ivre/vendredi-20/moto-title.png"
import MotoImage from "../images/le-bateau-ivre/vendredi-20/moto-image.png"

import NueitTitle from "../images/le-bateau-ivre/vendredi-20/nueit-title.png"
import NueitImage from "../images/le-bateau-ivre/vendredi-20/nueit-image.png"

import TachTitle from "../images/le-bateau-ivre/vendredi-20/tach-title.png"
import TachImage from "../images/le-bateau-ivre/vendredi-20/tach-image.png"

import GeysirTitle from "../images/le-bateau-ivre/vendredi-20/geysir-title.png"
import GeysirImage from "../images/le-bateau-ivre/vendredi-20/geysir-image.png"
---

<Layout title="NO NEW FEST - Le Bateau Ivre">
	<Header />

	<div class="flex flex-col mx-auto px-8" >

		<!-- JEUDI 19 MARS -->

		<section class="flex flex-col justify-center items-center" >
			<header>
				<Image src={Jeudi19Mars} alt="Arrow" class="mx-auto mt-[20px] w-[184px]" />		
			</header>

			<div class="flex flex-col justify-center items-center w-full" >

				<div class="flex flex-col justify-center items-center mr-auto mt-[37px]" >
					<Image src={FutuImage} alt="FutuImage" class="w-[216px]" />	
					<Image src={FutuTitle} alt="FutuTitle" class="h-[19px] w-auto relative right-12" />		
				</div>

				<div class="flex flex-col justify-center items-center ml-auto " >
					<Image src={PapierImage} alt="FutuImage" class="w-[180px]" />	
					<Image src={PapierTitle} alt="FutuTitle" class="w-[99px] h-auto relative bottom-71 left-16" />		
				</div>

				<div class="flex flex-col justify-center items-center ml-auto " >
					<Image src={OneHundredTitle} alt="FutuImage" class="w-[49px] h-auto relative right-32" />	
					<Image src={OneHundredImage} alt="FutuTitle" class="w-[288px]" />		
				</div>

				<div class="flex flex-col justify-center items-center mr-auto mt-[49px]" >
					<Image src={DwyneTitle} alt="DwyneImage" class="w-[89px] h-auto relative left-20 top-4" />	
					<Image src={DwyneImage} alt="DwyneTitle" class="w-[187px]" />		
				</div>

				<div class="flex flex-col justify-center items-center ml-auto mt-[50px]" >
					<Image src={GunsTitle} alt="GunsTitle" class="w-[166px] h-auto relative right-20" />	
					<Image src={GunsImage} alt="GunsImage" class="w-[183px] h-auto" />		
				</div>

			</div>

		</section>

		<!-- JEUDI 19 MARS -->

		<section class="flex flex-col justify-center items-center mt-[80px]" >
			<header>
				<Image src={Vendredi20Mars} alt="Arrow" class="mx-auto mt-[20px] w-[184px]" />		
			</header>

			<div class="flex flex-col justify-center items-center w-full" >

				<div class="flex flex-col justify-center items-center mr-auto mt-[64px]" >
					<Image src={WhatTitle} alt="WhatTitle" class="w-[216px] h-auto relative right-6" />	
					<Image src={WhatImage} alt="WhatImage" class="w-[267px] h-auto" />		
				</div>

				<div class="flex flex-col justify-center items-center mx-auto mt-[58px]" >
					<Image src={MotoImage} alt="MotoImage" class="w-[258px] h-auto" />	
					<Image src={MotoTitle} alt="MotoTitle" class="w-[146px] h-auto relative right-20" />		
				</div>

				<div class="flex flex-col justify-center items-center ml-auto mt-[73px]" >
					<Image src={GeysirTitle} alt="GeysirTitle" class="w-[74px] h-auto relative right-29 top-2" />		
					<Image src={GeysirImage} alt="GeysirImage" class="w-[208px] h-auto" />	
				</div>

				<div class="flex flex-col justify-center items-center mr-auto mt-[71px]" >
					<Image src={NueitImage} alt="NueitImage" class="w-[226px] h-auto " />	
					<Image src={NueitTitle} alt="NueitTitle" class="w-[87px] h-auto relative left-25 bottom-2 " />		
				</div>

				<div class="flex flex-row justify-center items-center ml-auto mt-[61px]" >
					<Image src={TachTitle} alt="TachTitle" class="w-[139px] h-auto -rotate-90 relative left-14" />		
					<Image src={TachImage} alt="TachImage" class="w-[179px] h-auto" />	
				</div>

			</div>

		</section>

	</div>


	<!-- <footer class="px-20 grid grid-cols-1 grid-rows-1 mt-22" > 
		<Image src={Arrow} alt="Arrow" class="col-start-1 row-start-1 relative rotate-180 right-34 bottom-18" />
		<Image src={Billetterie} alt="Billetterie" class="col-start-1 row-start-1" />
	</footer> -->
</Layout>
