---
import Layout from "../layouts/index.astro";

import { Image } from "astro:assets";
import BeforeFest from "../images/fests/before.jpg";
import DuringFest from "../images/fests/fest.jpg";
import Billetterie from "../images/billetterie.png";
---

<Layout title="NO NEW FEST - Le Bateau Ivre">
	<section class="px-20" >
		LE BATEAU
		<div class="flex flex-col gap-5 mt-10 justify-center items-center" >
			<a href="/le-bateau-ivre">
				<Image src={DuringFest} alt="During Fest" />
			</a>
			<Image src={BeforeFest} alt="Before Fest" />
		</div>
		<a href="">
			<Image src={Billetterie} alt="Billetterie" class="my-10 mx-auto" />
		</a>
	</section>
</Layout>
