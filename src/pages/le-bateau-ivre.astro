---
import Layout from "../layouts/index.astro";

import { Image } from "astro:assets";

import Header from "../components/Header.astro"

// JEUDI 19 MARS
import Jeudi19Mars from "../images/le-bateau-ivre/jeudi-19/title.png"

import FutuTitle from "../images/le-bateau-ivre/jeudi-19/futu-title.png"
import FutuImage from "../images/le-bateau-ivre/jeudi-19/futu-image.png"

import PapierTitle from "../images/le-bateau-ivre/jeudi-19/papier-title.png"
import PapierImage from "../images/le-bateau-ivre/jeudi-19/papier-image.png"

import OneHundredTitle from "../images/le-bateau-ivre/jeudi-19/178-title.png"
import OneHundredImage from "../images/le-bateau-ivre/jeudi-19/178-image.png"

import DwyneTitle from "../images/le-bateau-ivre/jeudi-19/dwyne-title.png"
import DwyneImage from "../images/le-bateau-ivre/jeudi-19/dwyne-image.png"

import GunsTitle from "../images/le-bateau-ivre/jeudi-19/guns-title.png"
import GunsImage from "../images/le-bateau-ivre/jeudi-19/guns-image.png"

import Jeudi19MarsDescription from "../images/le-bateau-ivre/jeudi-19/description.png"
import Jeudi19MarsDescriptionDesktop from "../images/le-bateau-ivre/jeudi-19/description_desktop.png"

// VENDREDI 20 MARS
import Vendredi20Mars from "../images/le-bateau-ivre/vendredi-20/title.png"

import WhatTitle from "../images/le-bateau-ivre/vendredi-20/what-title.png"
import WhatImage from "../images/le-bateau-ivre/vendredi-20/what-image.png"

import MotoTitle from "../images/le-bateau-ivre/vendredi-20/moto-title.png"
import MotoImage from "../images/le-bateau-ivre/vendredi-20/moto-image.png"

import NueitTitle from "../images/le-bateau-ivre/vendredi-20/nueit-title.png"
import NueitImage from "../images/le-bateau-ivre/vendredi-20/nueit-image.png"

import TachTitle from "../images/le-bateau-ivre/vendredi-20/tach-title.png"
import TachImage from "../images/le-bateau-ivre/vendredi-20/tach-image.png"
import NueitTitle from "../images/le-bateau-ivre/vendredi-20/nueit-title.png"
import NueitImage from "../images/le-bateau-ivre/vendredi-20/nueit-image.png"

import TachTitle from "../images/le-bateau-ivre/vendredi-20/tach-title.png"

import GeysirTitle from "../images/le-bateau-ivre/vendredi-20/geysir-title.png"
import GeysirImage from "../images/le-bateau-ivre/vendredi-20/geysir-image.png"

import VendrediDescription from "../images/le-bateau-ivre/vendredi-20/description.png"
import VendrediDescriptionDesktop from "../images/le-bateau-ivre/vendredi-20/description_desktop.png"

// SAMEDI 21 MARS

import Samedi21Mars from "../images/le-bateau-ivre/samedi-21/title.png"

import TvamTitle from "../images/le-bateau-ivre/samedi-21/tvam-title.png"
import TvamImage from "../images/le-bateau-ivre/samedi-21/tvam-image.png"

import KatyaImage from "../images/le-bateau-ivre/samedi-21/katya-image.png"
import KatyaTitle from "../images/le-bateau-ivre/samedi-21/katya-title.png"

import FoudreImage from "../images/le-bateau-ivre/samedi-21/foudre-image.png"
import FoudreTitle from "../images/le-bateau-ivre/samedi-21/foudre-title.png"

import PoliImage from "../images/le-bateau-ivre/samedi-21/poli-image.png"
import PoliTitle from "../images/le-bateau-ivre/samedi-21/poli-title.png"

import BongoImage from "../images/le-bateau-ivre/samedi-21/bongo-image.png"
import BongoTitle from "../images/le-bateau-ivre/samedi-21/bongo-title.png"

import Samedi21MarsDescription from "../images/le-bateau-ivre/samedi-21/description.png"
import Samedi21MarsDescriptionDesktop from "../images/le-bateau-ivre/samedi-21/description_desktop.png"

// billeterie
import Billetterie from "../images/le-bateau-ivre/billetterie/title.png"
import Arrow from "../images/le-bateau-ivre/billetterie/arrow.png"
---

<Layout title="NO NEW FEST - Le Bateau Ivre">
	<Header />

	<div class="flex flex-col mx-auto px-8 max-w-[1440px]" >

		<!-- JEUDI 19 MARS -->

		<section class="flex flex-col justify-center items-center" >
			<header class="lg:mr-auto mt-[20px] lg:mt-[106px]" >
				<Image src={Jeudi19Mars} alt="Arrow" class="mx-auto w-[184px] lg:w-[538px]" />		
			</header>

			<div class="flex flex-col justify-center items-center w-full lg:max-h-[1700px] lg:justify-normal" >

				<div class="flex flex-col justify-center items-center mr-auto mt-[37px] lg:mt-[74px] lg:mx-auto lg:relative	 lg:right-34" >
					<Image onclick="window.open('https://kythibong.bandcamp.com/album/utilisation-non-autoris-e', '_blank')" src={FutuImage} alt="FutuImage" class="w-[216px] lg:w-[358px]" />	
					<Image onclick="window.open('https://kythibong.bandcamp.com/album/utilisation-non-autoris-e', '_blank')" src={FutuTitle} alt="FutuTitle" class="h-[19px] lg:h-[48px] w-auto relative right-12 lg:right-40 lg:bottom-2" />		
				</div>

				<div class="flex flex-col justify-center items-center ml-auto lg:mx-auto lg:relative lg:bottom-50 lg:left-54 lg:mt-0" >
					<Image onclick="window.open('https://youtu.be/_Qs5IWPX3TQ?si=qMamodQbPr2Z4DhP', '_blank')" src={PapierImage} alt="PapierImage" class="w-[180px] lg:w-[360px]" />	
					<Image onclick="window.open('https://youtu.be/_Qs5IWPX3TQ?si=qMamodQbPr2Z4DhP', '_blank')" src={PapierTitle} alt="PapierTitle" class="w-[99px] lg:w-[286px] h-auto relative bottom-71 left-16 lg:bottom-150 lg:left-28" />		
				</div>

				<div class="flex flex-col justify-center items-center ml-auto lg:relative lg:bottom-102 lg:right-63 lg:mt-0" >
					<Image onclick="window.open('https://youtu.be/9tHpcea_v80?si=DP_sKKK4KfAvAziu', '_blank')" src={OneHundredTitle} alt="OneHundredTitle" class="w-[49px] lg:w-[142px] h-auto relative right-32 lg:top-8 lg:left-64" />	
					<Image onclick="window.open('https://youtu.be/9tHpcea_v80?si=DP_sKKK4KfAvAziu', '_blank')" src={OneHundredImage} alt="OneHundredImage" class="w-[288px] lg:w-[480px]" />		
				</div>

				<div class="flex flex-col justify-center items-center mr-auto mt-[49px] lg:mx-auto lg:relative lg:bottom-190 lg:right-65 lg:mt-0" >
					<Image onclick="window.open('https://youtu.be/Snb5tlwwv5M?si=T-LMmVN6nkTFWSRF', '_blank')" src={DwyneTitle} alt="DwyneImage" class="w-[89px] lg:w-[188px] h-auto relative left-20 top-4" />	
					<Image onclick="window.open('https://youtu.be/Snb5tlwwv5M?si=T-LMmVN6nkTFWSRF', '_blank')" src={DwyneImage} alt="DwyneTitle" class="w-[187px] lg:w-[433px]" />		
				</div>

				<div class="flex flex-col lg:flex-col-reverse justify-center items-center ml-auto mt-[50px] lg:relative lg:mt-0 lg:bottom-190 lg:mx-auto lg:left-34" >
					<Image src={GunsTitle} alt="GunsTitle" class="w-[166px] lg:w-[478px] h-auto relative right-20 lg:left-50 lg:bottom-10" />	
					<Image src={GunsImage} alt="GunsImage" class="w-[183px] lg:w-[334px]  h-auto" />		
				</div>

			</div>

			<Image src={Jeudi19MarsDescription} alt="description" class="mx-auto mt-[32px] lg:hidden" />
			<Image src={Jeudi19MarsDescriptionDesktop} alt="description" class="mx-auto mt-[86px] hidden lg:block" />

		</section>

		<!-- VENDREDI 20 MARS -->

		<section class="flex flex-col justify-center items-center mt-[80px] lg:mt-0" >
			<header class="mt-[20px] lg:mt-[294px] lg:ml-auto" >
				<Image src={Vendredi20Mars} alt="Arrow" class="mx-auto w-[184px] lg:w-[708px]" />		
			</header>

			<div class="flex flex-col justify-center items-center w-full mt-[64px] lg:mt-[138px] lg:max-h-[2100px] lg:relative lg:top-100" >

				<div class="flex flex-col justify-center items-center mr-auto lg:mx-auto lg:relative lg:right-52" >
					<Image onclick="window.open('https://youtu.be/8g2xgZw-0R4?si=-1diFN47B6H9X3sz', '_blank')" src={WhatTitle} alt="WhatTitle" class="w-[216px] lg:w-[304px] h-auto relative right-6 lg:relative lg:right-52" />	
					<Image onclick="window.open('https://youtu.be/8g2xgZw-0R4?si=-1diFN47B6H9X3sz', '_blank')" src={WhatImage} alt="WhatImage" class="w-[267px] lg:w-[554px] h-auto" />		
				</div>

				<div class="flex flex-col justify-center items-center mx-auto mt-[58px] lg:relative lg:bottom-16" >
					<Image onclick="window.open('https://motoraide.bandcamp.com/album/introducing-moto-raide-2', '_blank')" src={MotoImage} alt="MotoImage" class="w-[258px] lg:w-[719px] h-auto" />	
					<Image onclick="window.open('https://motoraide.bandcamp.com/album/introducing-moto-raide-2', '_blank')" src={MotoTitle} alt="MotoTitle" class="w-[146px] lg:w-[296px] h-auto relative right-20 lg:right-70 lg:bottom-8" />		
				</div>

				<div class="flex flex-col justify-center items-center ml-auto mt-[73px] lg:flex-col-reverse lg:mx-auto lg:relative lg:left-60 lg:bottom-50 lg:z-20" >
					<Image onclick="window.open('https://youtu.be/vZSUo3Tduz8?si=eI0ACjHxSqQ44R8b', '_blank')" src={GeysirTitle} alt="GeysirTitle" class="w-[74px] lg:w-[155px] h-auto relative right-29 top-2 lg:-right-45 lg:-top-12" />		
					<Image onclick="window.open('https://youtu.be/vZSUo3Tduz8?si=eI0ACjHxSqQ44R8b', '_blank')" src={GeysirImage} alt="GeysirImage" class="w-[208px] lg:w-[436px] h-auto" />	
				</div>

				<div class="flex flex-col justify-center items-center mr-auto mt-[71px] lg:mx-auto lg:mt-0 lg:relative lg:bottom-120 lg:right-53" >
					<Image onclick="window.open('https://youtu.be/-zxpDYS9i0o?si=wYoNKa5I-6n6EeoY', '_blank')" src={NueitImage} alt="NueitImage" class="w-[226px] lg:w-[471px] h-auto " />	
					<Image onclick="window.open('https://youtu.be/-zxpDYS9i0o?si=wYoNKa5I-6n6EeoY', '_blank')" src={NueitTitle} alt="NueitTitle" class="w-[87px] lg:w-[181px] h-auto relative left-25 bottom-2 lg:relative lg:-left-50" />		
				</div>

				<div class="flex flex-row justify-center items-center ml-auto mt-[61px] lg:mt-0 lg:mx-auto lg:flex-col-reverse lg:relative lg:bottom-195 lg:left-52" >
					<Image onclick="window.open('https://youtu.be/1uniej1hWpI?si=BBsZh1FXliR6EByH', '_blank')" src={TachTitle} alt="TachTitle" class="w-[139px] lg:w-[288px] h-auto -rotate-90 lg:rotate-0 relative left-14" />		
					<Image onclick="window.open('https://youtu.be/1uniej1hWpI?si=BBsZh1FXliR6EByH', '_blank')" src={TachImage} alt="TachImage" class="w-[179px] lg:w-[374px] h-auto" />	
				</div>

			</div>

			<Image src={VendrediDescription} alt="description" class="mt-[33px] mx-auto lg:hidden" ></Image>
			<Image src={VendrediDescriptionDesktop} alt="description" class="mt-[71px] mx-auto hidden lg:block" ></Image>

		</section>

		<!-- SAMEDI 21 MARS -->

		<section class="flex flex-col justify-center items-center mt-[80px]" >
			<header class="lg:mr-auto" >
				<Image src={Samedi21Mars} alt="Arrow" class="mx-auto mt-[80px] w-[224px] lg:w-[636px]" />		
			</header>

			<div class="flex flex-col justify-center items-center w-full mt-[44px]" >

				<div class="flex flex-col justify-center items-center relative right-8 lg:mx-auto lg:right-40 lg:mt-[112px]" >
					<Image onclick="window.open('https://youtu.be/pp3zpuF49SU?si=89FNLQiJECo0d-NF', '_blank')" src={TvamImage} alt="WhatImage" class="w-[240px] h-auto lg:w-[473px]" />
					<Image onclick="window.open('https://youtu.be/pp3zpuF49SU?si=89FNLQiJECo0d-NF', '_blank')" src={TvamTitle} alt="WhatTitle" class="w-[72px] lg:w-[192px] h-auto relative right-25 bottom-4 lg:bottom-136 lg:right-50" />
				</div>


				<div class="flex flex-col justify-center items-center relative left-20 mt-[77px] lg:mt-0 lg:mx-auto lg:left-77 lg:bottom-100" >
					<Image onclick="window.open('https://youtu.be/nug8XNwsDL4?si=PKTS0gzF8PFP7urD', '_blank')" src={KatyaTitle} alt="WhatTitle" class="w-[209px] lg:w-[474px] h-auto relative right-19 top-2 lg:top-4 -rotate-6 lg:-right-33 lg:rotate-2" />
					<Image onclick="window.open('https://youtu.be/nug8XNwsDL4?si=PKTS0gzF8PFP7urD', '_blank')" src={KatyaImage} alt="WhatImage" class="w-[211px] lg:w-[475px] h-auto" />
				</div>

				<div class="flex flex-col justify-center items-center relative mx-auto mt-[47px] lg:mt-0" >
					<Image onclick="window.open('https://youtu.be/ulVT1CCZp6Y?si=9T4oUVZy-M6m_eGb', '_blank')" src={FoudreTitle} alt="WhatTitle" class="w-[96px] lg:w-[231px] relative right-30 top-28 h-auto rotate-90" />
					<Image onclick="window.open('https://youtu.be/ulVT1CCZp6Y?si=9T4oUVZy-M6m_eGb', '_blank')" src={FoudreImage} alt="WhatImage" class="w-[208px] lg:w-[433px] h-auto" />
				</div>

				<div class="flex flex-col justify-center items-center mx-auto mt-[115px] lg:mt-0 relative right-18" >
					<Image src={PoliTitle} alt="BongoTitle" class="w-[261px] lg:w-[544px] h-auto relative left-18" />
					<Image src={PoliImage} alt="BongoImage" class="w-[226px] lg:w-[471px] h-auto" />
				</div>

				<div class="flex flex-col justify-center items-center mt-[70px] mx-auto lg:mt-0" >
					<Image onclick="window.open('https://youtu.be/QI4o7KfNCNs?si=BIyMWIh2suDgxntU', '_blank')" src={BongoImage} alt="BongoImage" class="w-[288px] lg:w-[599px] h-auto" />
					<Image onclick="window.open('https://youtu.be/QI4o7KfNCNs?si=BIyMWIh2suDgxntU', '_blank')" src={BongoTitle} alt="BongoTitle" class="w-[132px] lg:w-[279px] h-auto relative left-22" />
				</div>

			</div>

			<Image src={Samedi21MarsDescription} alt="description" class="mt-[55px] mx-auto lg:hidden" />
			<Image src={Samedi21MarsDescriptionDesktop} alt="description" class="mt-[79px] mx-auto hidden lg:block" />

		</section>

	</div>

	<footer class="mx-auto flex flex-col justify-center h-[150px] lg:h-auto mb-30" > 
		<Image src={Arrow} alt="Arrow" class="mx-auto w-[165px] lg:w-[349px] h-auto relative right-40 bottom-6 lg:right-120" />
		<Image src={Billetterie} alt="Billetterie" class="w-[192px] h-auto mx-auto relative bottom-14 lg:w-[565px]" />
	</footer>

</Layout>
