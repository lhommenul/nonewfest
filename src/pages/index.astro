---
import Layout from "../layouts/index.astro";

import { Image } from "astro:assets";
import BeforeFest from "../images/fests/before.jpg";
import DuringFest from "../images/fests/fest.jpg";
import Billetterie from "../images/billetterie.png";
---

<Layout title="NO NEW FEST">
	<section class="flex flex-col px-20 gap-10 md:gap-20" >
		<div class="flex flex-row flex-wrap gap-5 mt-10 lg:gap-20 justify-center" >
			<a href="/le-bateau-ivre" class="max-w-96" >
				<Image src={DuringFest} alt="During Fest" />
			</a>
			<a href="" class="max-w-96" >
				<Image src={BeforeFest} alt="Before Fest" />
			</a>
		</div>
		<a href="" class="mx-auto" >
			<Image src={Billetterie} alt="Billetterie" class="" />
		</a>
	</section>
</Layout>
