---
import Layout from "../layouts/index.astro";

import { Image } from "astro:assets";
import banner from "../images/banner.jpg";
import playlist from "../images/playlist.jpg"
import playlistText from "../images/playlist_text.png"
import email from "../images/email.jpg"
import instagram from "../images/instagram.jpg"
---

<Layout title="NO NEW FEST">
	<Image src={banner} alt="Banner" />

	<section>

		<article class="px-10 py-10 flex flex-col items-center justify-center" >
			<h2 class="grid grid-cols-1 row-cols-1 justify-items-center items-center w-38" >
				<a href="" class="col-start-1 col-end-1 row-start-1 row-end-1 z-0" >PLAYLIST 2026</a>
				<Image src={playlist} alt="Playlist" class="col-start-1 col-end-1 row-start-1 row-end-1 " />
			</h2>
			<Image src={playlistText} alt="" />
		</article>

	</section>

	<footer slot="footer" class="flex px-10 py-10 space-between w-full" >
		<a href="mailto:reversetapes@gmail.com" target="_blank" >
			<Image src={email} alt="Email" />
		</a>
		<a href="https://www.instagram.com/reversetapes/" target="_blank" >
			<Image src={instagram} alt="Instagram" />
		</a>
	</footer>
</Layout>
