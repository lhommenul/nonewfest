---
import Layout from "../layouts/index.astro";
import Header from "../components/Header.astro";

import { Image } from "astro:assets";
import BeforeFest from "../images/fests/before.png";
import DuringFest from "../images/fests/fest.jpg";
import Billetterie from "../images/billetterie.png";
---

<Layout title="NO NEW FEST" className="h-screen flex flex-col" >
	<Header />
	<section class="mt-4 flex justify-center items-center w-full" >
		<div class="flex flex-row lg:flex-nowrap flex-wrap justify-center px-10 gap-[30px] w-full max-w-[1200px]" >
			<a href="/le-bateau-ivre" class="w-full flex justify-center items-center lg:max-h-[72vh] hover:scale-105 transition-all" >
				<Image src={DuringFest} alt="During Fest" class="h-full w-auto"/>
			</a>
			<a href="/dans-la-ville" class="w-full flex justify-center items-center	lg:max-h-[72vh] hover:scale-105 transition-all" >
				<Image src={BeforeFest} alt="Before Fest" class="h-full w-auto"/>
			</a>
		</div>
	</section>
	<footer class="h-full flex flex-col justify-center lg:mb-0 mb-9">
		<a href="https://www.helloasso.com/associations/reverse-tapes/evenements/no-new-fest-2026" target="_blank" class="hover:scale-105 transition-all" >
			<Image src={Billetterie} alt="Billetterie" class="w-[147px] md:lg:w-[203px] lg:w-[233px] mx-auto mt-[31px] lg:relative lg:top-4 mb-0 lg:mb-0" />
		</a>
	</footer>
</Layout>
